# DIA Cardano Oracle — Indexer environment
#
# The indexer REUSES the feeder/CLI provider conventions, so the SAME .env that
# runs the feeder also runs the indexer. Only INDEXER_PORT (and the optional
# INDEXER_REGISTRY_FILE) are indexer-specific.

# Target network: Mainnet | Preview  (selects the registry; reader is agnostic)
CARDANO_NETWORK=Preview
# Chain provider: Blockfrost | Koios
CARDANO_PROVIDER=Blockfrost

# --- Preview (CARDANO_NETWORK=Preview reads the *_TESTNET variants) ---
BLOCKFROST_PROJECT_ID_TESTNET=
BLOCKFROST_API_URL_TESTNET=https://cardano-preview.blockfrost.io/api/v0
KOIOS_API_URL_TESTNET=https://preview.koios.rest/api/v1

# --- Mainnet (CARDANO_NETWORK=Mainnet reads the *_MAINNET variants) ---
BLOCKFROST_PROJECT_ID_MAINNET=
BLOCKFROST_API_URL_MAINNET=https://cardano-mainnet.blockfrost.io/api/v0
KOIOS_API_URL_MAINNET=https://api.koios.rest/api/v1

# --- Indexer-specific ---
# HTTP API listen port (default 3001).
INDEXER_PORT=3001
# Optional: path to a registry JSON, overriding the bundled per-network file
# (config/registry.<network>.json). Use it to point the indexer at a different
# deployment without a rebuild.
# INDEXER_REGISTRY_FILE=/path/to/registry.json
