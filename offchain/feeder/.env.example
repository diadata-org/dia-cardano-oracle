# DIA Cardano Oracle Feeder — environment variables.
#
# Design rule (see milestone-2-plan.md Annex D):
#
#   * The modular YAML config in `config/` is the single source of
#     truth for every public data point (chain ids, RPC URLs, WS URLs,
#     registry addresses, ABIs). It mirrors the upstream Spectra
#     Bridge schema (`services/bridge/config/`) verbatim — no
#     feeder-side fields invented.
#   * `.env` carries only:
#       - selectors (which network, which provider, log level, dry-run),
#       - secrets (project ids, wallet seeds, WS credentials, DSNs),
#       - daemon-only operational knobs that the Spectra Bridge also
#         exposes via env (API addr, metrics enabled, DB driver),
#       - informational values that Spectra does NOT have in its YAML
#         schema (the DIA explorer URL — used by future log/`/api/v1/prices`
#         link rendering).
#
# Variables intentionally absent (relative to offchain/cli/.env):
#   * `DIA_AUTHORIZED_PRIVATE_KEY_*`   — only signers (the CLI) need it.
#   * `DIA_DOMAIN_NAME` / `_VERSION` — only signers + on-chain verifiers
#                                     need the EIP-712 domain.
#   * `DIA_SOURCE_CHAIN_ID_*`   — lives in
#                                 `config/infrastructure.<network>.yaml::source.chain_id`.
#   * `DIA_RPC_URL_*`          — lives in
#                                 `config/infrastructure.<network>.yaml::source.rpc_urls`.
#   * `DIA_WS_URL_*`           — lives in
#                                 `config/infrastructure.<network>.yaml::source.ws_url`.
#   * `DIA_REGISTRY_ADDRESS_*` — lives in
#                                 `config/contracts.yaml::<id>.address`.

# ============================================================================
# Active network selector (drives which `*_TESTNET` / `*_MAINNET` block is
# read AND which `infrastructure.<network>.yaml` the loader picks up).
# ============================================================================
CARDANO_NETWORK=Preview

# ============================================================================
# Cardano provider switch + tx confirmation timeouts (network-agnostic).
# Mirror offchain/cli/.env exactly.
# ============================================================================
CARDANO_PROVIDER=Blockfrost

# TX_CONFIRMATION_PRIMARY_TIMEOUT_MS=180000
# TX_CONFIRMATION_KOIOS_ATTEMPTS=60
# TX_CONFIRMATION_KOIOS_DELAY_MS=3000
# TX_CONFIRMATION_BLOCKFROST_ATTEMPTS=30
# TX_CONFIRMATION_BLOCKFROST_DELAY_MS=6000

# ============================================================================
# Cardano destination secrets — Testnet (Preview).
# ============================================================================
BLOCKFROST_PROJECT_ID_TESTNET=
BLOCKFROST_API_URL_TESTNET=https://cardano-preview.blockfrost.io/api/v0
KOIOS_API_URL_TESTNET=https://preview.koios.rest/api/v1

# Signer wallet(s) that pay for Cardano oracle-update transactions on Preview.
# With no `wallets:` block in infrastructure.preview.yaml the feeder uses this
# single wallet (the `main`). To run a POOL of wallets — so parallel lanes never
# contend for the same fee/collateral UTxO — declare a `wallets:` block whose
# entries reference one env var each, and add the corresponding seeds/keys here:
#   CARDANO_WALLET_SEED_TESTNET_POOL_1=
#   CARDANO_WALLET_SEED_TESTNET_POOL_2=
# An env var name containing PRIVATE_KEY is read as a raw key; otherwise a seed.
CARDANO_WALLET_SEED_TESTNET=
CARDANO_PRIVATE_KEY_TESTNET=

# ============================================================================
# Cardano destination secrets — Mainnet.
# ============================================================================
BLOCKFROST_PROJECT_ID_MAINNET=
BLOCKFROST_API_URL_MAINNET=https://cardano-mainnet.blockfrost.io/api/v0
KOIOS_API_URL_MAINNET=https://api.koios.rest/api/v1

# Single `main` wallet by default; add `wallets:` in infrastructure.mainnet.yaml
# plus one env var per pool wallet to run a pool (e.g. CARDANO_WALLET_SEED_MAINNET_POOL_1).
CARDANO_WALLET_SEED_MAINNET=
CARDANO_PRIVATE_KEY_MAINNET=
CARDANO_WALLET_SEED_MAINNET_POOL_1=
CARDANO_WALLET_SEED_MAINNET_POOL_2=

# ============================================================================
# DIA source — credentials only. Endpoints + addresses live in the YAML.
# ============================================================================
DIA_WS_CREDENTIAL_TESTNET=
DIA_WS_CREDENTIAL_MAINNET=

# DIA's authorized signer public keys (comma-separated compressed secp256k1
# pubkeys, no 0x). The DAEMON does not read these — it gets them from the
# config-bootstrap.json it imports. They are here because the shared image's
# CLI deploy commands (make protocol-init / config-update / run-all) read this
# env file, and protocol:init / config:update authorize these keys so the
# feeder's real DIA intents are accepted. Recovered from the live registries.
# Mainnet: authorize ONLY DIA's real keys — never a key whose private half we hold.
DIA_AUTHORIZED_PUBLIC_KEYS_TESTNET=03aafe60df69602d2600363bf9830b9ba09f199e7c1c1bda7c0be88a3ed341b807,03c7d448ea95104a628945f43745f177f1e9895c6d4c8e43614d7b1c0395469b2d
DIA_AUTHORIZED_PUBLIC_KEYS_MAINNET=02fa12f4143fca6652fa5a365fd1ada14495aab0dd3c1e568755e2230b38a4706d,02571284d2657052e68dc506c879f710d997a9801a5502339ff22f26bf85b958bd

# Informational only — no counterpart in the Spectra Bridge YAML schema, so
# kept here. Used by future log/explorer link rendering. The feeder does not
# need these to scan or submit.
DIA_EXPLORER_URL_TESTNET=https://testnet-explorer.diadata.org
DIA_EXPLORER_URL_MAINNET=https://explorer.diadata.org

# ============================================================================
# Feeder daemon — names mirror diadata-org/Spectra-interoperability bridge
# .env.example where applicable. Network-agnostic except where suffixed.
# ============================================================================

# Per-run state selector. The feeder keeps each deployment's state in
# state/<network>_run_<RUN_ID>/ (DB, logs, pair state) — the SAME run id the
# CLI used (cli/state/<network>_run_<id>/), so multiple deployments never
# clobber each other. `make init-bootstrap` / `init-client` import a CLI run
# into the matching feeder run dir.
#   RUN_ID set    -> the daemon uses state/<network>_run_<RUN_ID>/
#   RUN_ID empty  -> the daemon uses the NEWEST state/<network>_run_* dir
# Leave it empty here and pass it per-invocation (make up RUN_ID=...), or pin
# one deployment by setting it.
RUN_ID=

# Persistence. Same key names as Spectra Bridge: DATABASE_DRIVER + DATABASE_DSN.
# SQLite (driver=sqlite, path-based) or Postgres (DSN), suffixed per network.
DATABASE_DRIVER=sqlite   # sqlite | postgres

# When DATABASE_DRIVER=sqlite (default): DO NOT set DATABASE_PATH_* — the daemon
# derives state/<network>_run_<id>/feeder.sqlite from the active run (see RUN_ID).
# Set DATABASE_PATH_TESTNET / DATABASE_PATH_MAINNET only to PIN a fixed path and
# opt out of per-run isolation.

# When DATABASE_DRIVER=postgres:
# DATABASE_DSN_TESTNET=postgres://feeder:password@localhost:5432/feeder_preview?sslmode=disable
# DATABASE_DSN_MAINNET=postgres://feeder:password@localhost:5432/feeder_mainnet?sslmode=disable

# Prometheus metrics. Same key names as Spectra.
METRICS_ENABLED=true
METRICS_NAMESPACE=dia_bridge

# Grafana admin password (monitoring stack, `make up MONITORING=1`).
# IMPORTANT: this is consumed by Grafana ONLY the first time the
# `grafana-data` Docker volume is created. After that the password lives in
# Grafana's own DB inside the volume and this value is ignored — `make build`
# / `down` / `up` do NOT reset it. To make a change here take effect you must
# recreate the volume (run from offchain/):
#   make down
#   docker volume rm feeder_grafana-data      # no make shortcut for this step
#   make up MONITORING=1
# The dashboard re-provisions automatically; nothing is lost.
# Default when unset: admin.
GRAFANA_ADMIN_PASSWORD=admin

# Alertmanager notification secrets (monitoring stack). LEAVE EMPTY unless you
# turn a channel ON in infrastructure.<network>.yaml::notifications. They reach
# Alertmanager as files (docker-compose writes them to /etc/alertmanager/secrets);
# the config never contains the secret. To enable a channel: set its `enabled: true`
# + recipient/chat in the infra YAML, put the secret here, then `make up MONITORING=1`.
# Telegram: the bot token from @BotFather (chat_id goes in the infra YAML).
ALERTMANAGER_TELEGRAM_BOT_TOKEN=
# Email: the SMTP password (host/from/recipients go in the infra YAML).
ALERTMANAGER_SMTP_PASSWORD=

# Run the pipeline (scanner, router, queue) but do not submit Cardano txs.
# Same key name as Spectra. Useful for QA and replays.
DRY_RUN=false

# Log level. Can also be overridden by the --log-level CLI flag.
# Same key name as Spectra.
LOG_LEVEL=info

# NOTE: the scanner start block is NOT an env var. It lives in
# config/infrastructure.<network>.yaml under `source.start_block`, the same
# way the upstream Spectra Bridge keeps it in `infrastructure.yaml`. The
# env-driven checkpoint is the persisted `chain_state.last_processed_block`
# in the database, which always wins over the YAML default once the feeder
# has seen at least one block.

# Directory where the feeder writes per-intent structured JSON log files.
# Defaults to the active run dir's logs (state/<network>_run_<id>/logs, or the
# flat state/<network>/logs when no run dir exists). Override to write to a
# central log directory when running multiple network instances on one host.
# FEEDER_LOG_DIR=state/preview/logs
