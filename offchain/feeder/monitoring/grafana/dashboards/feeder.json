{
  "__inputs": [],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "DIA Cardano Oracle Feeder — operational overview and M2 evidence",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 200,
      "title": "Oracle Feed Liveness — M2 Evidence (10 Asset Price Pairs)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Cumulative count of confirmed Cardano oracle update transactions per price pair. Non-zero values for all 10 pairs confirm oracle liveness. This is the primary M2 evidence metric.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 5
              }
            ]
          },
          "custom": {}
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 11,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "sum by (symbol) (dia_bridge_transactions_confirmed_total{network=~\"$network\", symbol=~\"$symbol\", client_id=~\"$client\"})",
          "legendFormat": "{{symbol}}",
          "refId": "A"
        }
      ],
      "title": "Confirmed oracle updates — all-time total (per pair)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "95th-percentile age of incoming DIA price data at the moment it was processed (1-hour window), recorded ONLY for the pairs this feeder routes (not the hundreds of other symbols the source feed carries). Values above 600 s indicate the DIA source is publishing stale prices for a routed pair and may trigger the PriceAgeHigh alert.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 300
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          },
          "custom": {}
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 12,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, symbol) (rate(dia_bridge_price_age_seconds_bucket{network=~\"$network\", symbol=~\"$symbol\"}[1h])))",
          "legendFormat": "{{symbol}}",
          "refId": "A"
        }
      ],
      "title": "Price data age p95 — 1 h window (per routed pair)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 100,
      "title": "Row 1 — Balances & Staleness",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Seconds since each pair was last confirmed on-chain. Values above 3600 s (alerting.oracle_pair_stale_seconds) trigger the OraclePairStale alert.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1800
              },
              {
                "color": "red",
                "value": 3600
              }
            ]
          },
          "custom": {}
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "id": 1,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "time() - dia_bridge_cardano_oracle_last_confirmed_timestamp_seconds{network=~\"$network\", symbol=~\"$symbol\", client_id=~\"$client\"}",
          "legendFormat": "{{symbol}}",
          "refId": "A"
        }
      ],
      "title": "Pair staleness (per symbol)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Receiver prepaid balance in ADA. Below 2 ADA (alerting.receiver_balance_low_lovelace) triggers ReceiverBalanceLow. The backing metric labels include receiver_address and deposit_address; fund the deposit address, not the Receiver script address.",
      "fieldConfig": {
        "defaults": {
          "unit": "ADA",
          "decimals": 2,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "green",
                "value": 10
              }
            ]
          },
          "custom": {}
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "id": 2,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "dia_bridge_cardano_receiver_balance_lovelace{network=~\"$network\", client_id=~\"$client\"} / 1000000",
          "legendFormat": "{{client_id}}",
          "refId": "A"
        }
      ],
      "title": "Receiver balance — ADA (per client)",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Operational wallet balances in ADA (all clients). Admin (signer) wallet — fires AdminWalletLow below 5 ADA. PaymentHook accrued — fires PaymentHookWithdrawReady above 50 ADA. Receiver accrued (sum) — fires SettleOverdue above 10 ADA.",
      "fieldConfig": {
        "defaults": {
          "unit": "ADA",
          "decimals": 2,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 5
              }
            ]
          },
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "PaymentHook accrued"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 50
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Receiver accrued (sum)"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 10
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "id": 3,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "dia_bridge_cardano_admin_wallet_lovelace{network=~\"$network\"} / 1000000",
          "legendFormat": "Admin wallet",
          "refId": "A"
        },
        {
          "expr": "dia_bridge_cardano_payment_hook_accrued_lovelace{network=~\"$network\"} / 1000000",
          "legendFormat": "PaymentHook accrued",
          "refId": "B"
        },
        {
          "expr": "sum(dia_bridge_cardano_receiver_accrued_lovelace{network=~\"$network\"}) / 1000000",
          "legendFormat": "Receiver accrued (sum)",
          "refId": "C"
        }
      ],
      "title": "Admin wallet • PaymentHook • Receiver accrued — ADA",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Largest single pure-ADA UTxO in the admin/signer wallet (all clients). A script tx needs a collateral UTxO distinct from its fee inputs, so THIS — not the total — determines whether the wallet can build. Below the collateral floor the wallet is fragmented (AdminWalletFragmented, critical) even if the total looks healthy; the daemon auto-consolidates below auto_consolidate_below_lovelace.",
      "fieldConfig": {
        "defaults": {
          "unit": "ADA",
          "decimals": 2,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 10
              }
            ]
          },
          "custom": {}
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "id": 201,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "dia_bridge_cardano_admin_wallet_max_utxo_lovelace{network=~\"$network\"} / 1000000",
          "legendFormat": "Largest UTxO",
          "refId": "A"
        }
      ],
      "title": "Admin wallet — largest UTxO — ADA (collateral floor)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Un-merged client deposits (side-deposit funding) waiting at the per-client deposit address, in ADA. Above 5 ADA (alerting.deposit_pending_merge_lovelace) triggers the ReceiverDepositsPending alert — run `deposit:merge` to fold the deposits into the Receiver balance.",
      "fieldConfig": {
        "defaults": {
          "unit": "ADA",
          "decimals": 2,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              }
            ]
          },
          "custom": {}
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 18
      },
      "id": 15,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "dia_bridge_cardano_deposit_pending_lovelace{network=~\"$network\", client_id=~\"$client\"} / 1000000",
          "legendFormat": "{{client_id}}",
          "refId": "A"
        }
      ],
      "title": "Deposit pending — ADA (per client)",
      "type": "gauge"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "id": 101,
      "title": "Row 2 — Symbol Throughput & Latency",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Per-symbol pipeline latency (processing start to confirmation), p50/p95/p99 over a 5-minute window, aggregated across all pairs. For TRANSACTION-level latency per stage, see the 'Feeder — Transactions' dashboard.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 27
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(dia_bridge_end_to_end_latency_seconds_bucket{network=~\"$network\", symbol=~\"$symbol\", client_id=~\"$client\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(dia_bridge_end_to_end_latency_seconds_bucket{network=~\"$network\", symbol=~\"$symbol\", client_id=~\"$client\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(dia_bridge_end_to_end_latency_seconds_bucket{network=~\"$network\", symbol=~\"$symbol\", client_id=~\"$client\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "Symbol-update latency (p50/p95/p99)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Confirmed symbol updates in each 5-minute window, per pair (a batch tx of N pairs adds 1 to each of its N symbols). A count, not a rate. For pure per-TRANSACTION counts see 'Tx confirmed vs failed'.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 27
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by (symbol) (increase(dia_bridge_transactions_confirmed_total{network=~\"$network\", symbol=~\"$symbol\", client_id=~\"$client\"}[5m]))",
          "legendFormat": "{{symbol}}",
          "refId": "A"
        }
      ],
      "title": "Symbol updates confirmed (5m)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Failed symbol updates in each 5-minute window grouped by error code (a count, not a rate). REAL failures only — superseded intents (NonMonotonicNonce, no tx, no fee) are counted separately in dia_bridge_intents_superseded_total{reason}, not here.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 27
      },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by (error_code) (increase(dia_bridge_transactions_failed_total{network=~\"$network\", symbol=~\"$symbol\", client_id=~\"$client\", error_code=~\"$error_code\"}[5m]))",
          "legendFormat": "{{error_code}}",
          "refId": "A"
        }
      ],
      "title": "Symbol-update failures (5m, by error code)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "id": 105,
      "title": "Row 2b — Transactions (per tx)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Cardano TRANSACTIONS in each 5-minute window, counted once per tx (a batch of N pairs is ONE tx), by outcome. Condemned no-ops are excluded — these are real transactions only.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "id": 16,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by (outcome) (increase(dia_bridge_transactions_total{network=~\"$network\", client_id=~\"$client\", customer_id=~\"$customer\"}[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Tx confirmed vs failed (5m)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Batch size distribution: how many pairs travel in each transaction, p50/p95 over a 5-minute window.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "id": 17,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(dia_bridge_transaction_pairs_bucket{network=~\"$network\", client_id=~\"$client\", customer_id=~\"$customer\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(dia_bridge_transaction_pairs_bucket{network=~\"$network\", client_id=~\"$client\", customer_id=~\"$customer\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "title": "Pairs per tx (p50/p95)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 44
      },
      "id": 102,
      "title": "Row 3 — Chain & Scanner Health",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Total reorgs detected in the last hour. Non-zero values indicate chain instability.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "custom": {}
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 45
      },
      "id": 7,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "sum(increase(dia_bridge_transactions_reorg_total{network=~\"$network\", symbol=~\"$symbol\", client_id=~\"$client\"}[1h]))",
          "legendFormat": "reorgs / 1h",
          "refId": "A"
        }
      ],
      "title": "Reorg counter",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Blocks behind the chain tip. High values indicate the scanner is falling behind (all clients).",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 45
      },
      "id": 8,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "dia_bridge_scanner_block_lag{network=~\"$network\"}",
          "legendFormat": "block lag",
          "refId": "A"
        }
      ],
      "title": "Scanner block lag",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Intents suppressed before routing in each 5-minute window grouped by filter reason (a count, not a rate). High counts are normal: the deviation/time-threshold policy suppresses most intents by design.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 45
      },
      "id": 9,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by (reason) (increase(dia_bridge_intents_filtered_total{network=~\"$network\", symbol=~\"$symbol\"}[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "title": "Intents filtered (5m, by reason)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 53
      },
      "id": 103,
      "title": "Row 4 — Price Quality & Anomaly Detection",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "95th-percentile price deviation per symbol over the last hour. Values above 5% trigger the PriceDeviationHigh alert (potential misreport). Green = within normal bounds.",
