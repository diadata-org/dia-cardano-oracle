# Active network selector. The ONLY unsuffixed variable in this file.
# Drives which *_TESTNET / *_MAINNET variant of every other setting the
# CLI reads at runtime. Supported values: Preview, Mainnet.
#
# Cardano Preview  pairs with  DIA Testnet  → reads *_TESTNET
# Cardano Mainnet  pairs with  DIA Mainnet  → reads *_MAINNET
CARDANO_NETWORK=Preview

# Cardano chain provider. Network-agnostic; same value for either network.
CARDANO_PROVIDER=Blockfrost

# Tx confirmation timeouts. Network-agnostic; leave commented for defaults.
# TX_CONFIRMATION_PRIMARY_TIMEOUT_MS=180000
# TX_CONFIRMATION_KOIOS_ATTEMPTS=60
# TX_CONFIRMATION_KOIOS_DELAY_MS=3000
# TX_CONFIRMATION_BLOCKFROST_ATTEMPTS=30
# TX_CONFIRMATION_BLOCKFROST_DELAY_MS=6000

# DIA EIP-712 domain. Network-independent (the same OracleIntent type
# is signed on both DIA Testnet and DIA Mainnet).
DIA_DOMAIN_NAME="DIA Oracle"
DIA_DOMAIN_VERSION=1.0

# ============================================================================
# Cardano — Testnet (Preview)
# ============================================================================
BLOCKFROST_PROJECT_ID_TESTNET=
BLOCKFROST_API_URL_TESTNET=https://cardano-preview.blockfrost.io/api/v0
KOIOS_API_URL_TESTNET=https://preview.koios.rest/api/v1

# Wallet used to fund every Cardano Preview transaction.
# Generate via:  npm run cli -- wallet:create
CARDANO_WALLET_SEED_TESTNET=
CARDANO_PRIVATE_KEY_TESTNET=

# ============================================================================
# Cardano — Mainnet
# ============================================================================
BLOCKFROST_PROJECT_ID_MAINNET=
BLOCKFROST_API_URL_MAINNET=https://cardano-mainnet.blockfrost.io/api/v0
KOIOS_API_URL_MAINNET=https://api.koios.rest/api/v1

# Wallet used to fund every Cardano Mainnet transaction.
CARDANO_WALLET_SEED_MAINNET=
CARDANO_PRIVATE_KEY_MAINNET=

# ============================================================================
# DIA source — Testnet (paired with Cardano Preview)
# Canonical confirmed values (2026-05-20).
# ============================================================================
DIA_SOURCE_CHAIN_ID_TESTNET=10050
DIA_RPC_URL_TESTNET=https://testnet-rpc.diadata.org
DIA_WS_URL_TESTNET=wss://testnet-rpc.diadata.org
DIA_REGISTRY_ADDRESS_TESTNET=0xF8c614A483A0427A13512F52ac72A576678bE317
DIA_EXPLORER_URL_TESTNET=https://testnet-explorer.diadata.org

# LOCAL signer private key (EVM/secp256k1) — the key the CLI / run-all use to
# SELF-SIGN demo OracleIntents on testnet. It is OURS, not DIA's; its derived
# public key is authorized automatically. Pairs with DIA_AUTHORIZED_PUBLIC_KEYS
# below — DIA's real, verify-only signer keys (we only hold the public halves).
DIA_AUTHORIZED_PRIVATE_KEY_TESTNET=
# DIA WebSocket credential for testnet (Conduit path-style key).
DIA_WS_CREDENTIAL_TESTNET=
# DIA's authorized signer public keys on testnet (comma-separated compressed
# secp256k1 pubkeys, no 0x), recovered from the live testnet registry.
# protocol:init / config:update authorize these so the feeder's real DIA intents
# are accepted. run-all additionally authorizes the DIA_AUTHORIZED_PRIVATE_KEY_TESTNET
# self-sign key for its Preview demo updates.
DIA_AUTHORIZED_PUBLIC_KEYS_TESTNET=03aafe60df69602d2600363bf9830b9ba09f199e7c1c1bda7c0be88a3ed341b807,03c7d448ea95104a628945f43745f177f1e9895c6d4c8e43614d7b1c0395469b2d

# ============================================================================
# DIA source — Mainnet (paired with Cardano Mainnet)
# Canonical confirmed values (2026-05-20).
# ============================================================================
DIA_SOURCE_CHAIN_ID_MAINNET=1050
DIA_RPC_URL_MAINNET=https://rpc.diadata.org
DIA_WS_URL_MAINNET=wss://rpc.diadata.org
DIA_REGISTRY_ADDRESS_MAINNET=0x5612599CF48032d7428399d5Fcb99eDcc75c06A7
DIA_EXPLORER_URL_MAINNET=https://explorer.diadata.org

# LOCAL signer private key for mainnet. Leave UNSET for a real deployment — on
# mainnet authorize ONLY DIA's real public keys (below), never a key whose
# private half we hold.
DIA_AUTHORIZED_PRIVATE_KEY_MAINNET=
# DIA WebSocket credential for mainnet.
DIA_WS_CREDENTIAL_MAINNET=
# DIA's authorized signer public keys on mainnet (comma-separated compressed
# secp256k1 pubkeys, no 0x), recovered from the live mainnet registry.
# Authorize ONLY DIA's real keys here — never a key whose private half we hold
# (do not set DIA_AUTHORIZED_PRIVATE_KEY_MAINNET for a real deployment).
DIA_AUTHORIZED_PUBLIC_KEYS_MAINNET=02fa12f4143fca6652fa5a365fd1ada14495aab0dd3c1e568755e2230b38a4706d,02571284d2657052e68dc506c879f710d997a9801a5502339ff22f26bf85b958bd
