{
  "openapi": "3.0.3",
  "info": {
    "title": "DIA Cardano Oracle Indexer API",
    "version": "0.1.0",
    "description": "Read-only HTTP API over the live on-chain DIA oracle Pair/Receiver UTxOs. Generated from the in-code route table; cannot drift from the implementation."
