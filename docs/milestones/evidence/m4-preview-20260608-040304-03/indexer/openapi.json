                    "perPairFeeLovelace",
                    "feeFormula",
                    "exampleSinglePairFeeLovelace"
                  ],
                  "properties": {
                    "baseFeeLovelace": {
                      "description": "Constant component of the fee formula (lovelace).",
                      "type": "string"
                    },
                    "perPairFeeLovelace": {
                      "description": "Per-pair component of the fee formula (lovelace).",
                      "type": "string"
                    },
                    "feeFormula": {
                      "description": "Human-readable formula: base + N × perPair.",
                      "type": "string"
                    },
                    "exampleSinglePairFeeLovelace": {
