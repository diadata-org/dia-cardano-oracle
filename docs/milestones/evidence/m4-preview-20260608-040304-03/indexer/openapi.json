  "paths": {
    "/v1/health": {
      "get": {
        "summary": "Provider reachable, chain tip, and live pair count.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "tip",
                    "pairCount"
                  ],
                  "properties": {
                    "tip": {
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "slot",
                        "height",
                        "hash"
                      ],
                      "properties": {
                        "slot": {
                          "type": "integer"
                        },
                        "height": {
                          "type": "integer"
                        },
                        "hash": {
                          "type": "string"
                        }
                      }
                    },
                    "pairCount": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal error.",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/pairs": {
      "get": {
        "summary": "Every published pair with its latest on-chain value and UTxO ref.",
        "operationId": "pairs",
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "pairs"
                  ],
                  "properties": {
                    "pairs": {
                      "type": "array",
                      "items": {
                        "additionalProperties": false,
                        "type": "object",
                        "required": [
                          "symbol",
                          "pairId",
                          "pairPolicyId",
                          "price",
                          "timestamp",
                          "nonce",
                          "signer",
                          "intentHash",
                          "minUtxoLovelace",
                          "utxoRef",
                          "ageSeconds",
                          "clientId"
                        ],
                        "properties": {
                          "symbol": {
                            "type": "string"
                          },
                          "pairId": {
                            "description": "Hex-encoded pair id.",
                            "type": "string"
                          },
                          "pairPolicyId": {
                            "description": "Policy id of the Pair NFT — authenticate the reference input with it.",
                            "type": "string"
                          },
                          "price": {
                            "description": "Integer price (DIA fixed-point) as a decimal string.",
                            "type": "string"
                          },
                          "timestamp": {
                            "description": "Unix seconds as a decimal string.",
                            "type": "string"
                          },
                          "nonce": {
                            "type": "string"
                          },
                          "signer": {
                            "type": "string"
                          },
                          "intentHash": {
                            "type": "string"
                          },
                          "minUtxoLovelace": {
                            "type": "string"
                          },
                          "utxoRef": {
                            "additionalProperties": false,
                            "type": "object",
                            "required": [
                              "txHash",
                              "outputIndex"
                            ],
                            "properties": {
                              "txHash": {
                                "description": "Transaction hash of the Pair UTxO.",
                                "type": "string"
                              },
                              "outputIndex": {
                                "description": "Output index within that transaction.",
                                "type": "integer"
                              }
                            }
                          },
                          "ageSeconds": {
                            "description": "now − timestamp at query time.",
                            "type": "integer"
                          },
                          "clientId": {
                            "type": "string"
                          }
                        }
                      }
                    }
