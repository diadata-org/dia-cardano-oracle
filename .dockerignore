# Build context = repo root (offchain/feeder/docker-compose.yml build.context: ../..).
# Keep the context small: the image installs deps (npm ci) and compiles in-image,
# so host node_modules / dist / build caches must NOT be shipped. Runtime data
# (state, evidence, .env) is bind-mounted at run time, not baked.

.git
**/node_modules
**/dist

# Aiken build cache + downloaded packages (regenerated by `aiken build`).
contracts/aiken/build

# Runtime state + evidence (bind-mounted, never baked).
offchain/state
docs/milestones/evidence

# Secrets + local env (provided via compose env_file at run time).
**/.env
**/.env.*
!**/.env.example

# Editor / tooling dirs (local only — mirrors .gitignore).
.vscode
.codex
.mcp
.playwright-mcp
.windsurf
.devin
.claude

# Local notes / personal backups — never ship (mirrors .gitignore).
**/archived/
**/_archived/
**/OLD/
**/_OLD/
**/BK/
**/_BK/
*_OLD
*_BK

# External reference repos (local only, not committed).
docs/references/spectra

# Logs / OS noise.
docs/milestones/evidence/m2-*/logs/intents
**/*.log
**/.DS_Store
